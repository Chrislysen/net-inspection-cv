# Keep directory placeholders
!**/.gitkeep

# Curated result images for the README/report ARE tracked (small, illustrative)
!docs/
!docs/**

# Committed prototype model artifacts (override the *.pt / *.npz ignores above)
!models/
!models/*.pt
!models/*.npz
!models/*.onnx        # exported deployment artifact (12 MB)

# OS / editor
.DS_Store
.vscode/
.idea/

