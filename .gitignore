.ultralytics/

# Data & outputs (regenerable; keep the repo light)
data/raw/
data/processed/
data/sample/
outputs/
runs/
reports/assets/
*.pt
*.bag        # large SOLAQUA ROS bags (download via scripts/fetch_solaqua.py)
