# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ultralytics/

# Data & outputs (regenerable; keep the repo light)
data/raw/
data/processed/
data/sample/
outputs/
runs/
reports/assets/
*.pt
*.bag        # large SOLAQUA ROS bags (download via scripts/fetch_solaqua.py)
*.npz        # trained anomaly models

# Keep directory placeholders
!**/.gitkeep

# Curated result images for the README/report ARE tracked (small, illustrative)
!docs/
!docs/**

# Committed prototype model artifacts (override the *.pt / *.npz ignores above)
!models/
!models/*.pt
!models/*.npz
!models/*.onnx        # exported deployment artifact (12 MB)

# OS / editor
.DS_Store
.vscode/
.idea/

# Per-operator planning output names a company; regenerate with
# scripts/site_planner.py --operator <NAME> --forecast
reports/results/site_planning/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# --- secrets and local credentials -------------------------------------------
# The service and the assistant read their keys from the environment
# (NETINSPECT_API_KEY, NETINSPECT_OPENAI_API_KEY, ANTHROPIC_API_KEY). Nothing
# here should ever hold one, but this repo is public: a single accidental
# `git add .` of a .env is unrecoverable once pushed, because history is public
# too. Deny the shapes rather than rely on remembering.
.env
.env.*
!.env.example
*.pem
*.key
!**/*public*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.*
secrets/
credentials.*
.netrc
.aws/
.ssh/
*.token
service-account*.json

# Personal / application material lives OUTSIDE this repository on purpose
# (see ../brief). These patterns are belt-and-braces in case anything is ever
# copied in by mistake.
cover_email*
*dossier*
*_DOSSIER*
resume*
cv_*.pdf
